DATABASE_URL=postgres://quiz:quiz@localhost:5434/quiz
PORT=3000
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Where uploaded images are stored and the public URL prefix they are served from
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=/uploads
# Built web app served by this server (default ../web/dist)
# WEB_DIST=../web/dist
# Set to true only when running behind a reverse proxy (Nginx)
# TRUST_PROXY=false
# Mobile app WebView origins allowed cross-origin (default: capacitor://localhost,https://localhost)
# APP_ORIGINS=capacitor://localhost,https://localhost
